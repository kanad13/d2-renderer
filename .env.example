# Every environment variable the code and scripts read. Values shown are the defaults.
# Copy to .env only if your runner loads it; nothing in this repository requires a .env file.

# server.py (also read by Cloud Run, which injects PORT)
PORT=8088
# Bind address. The container default is 0.0.0.0; manage-daemon.sh defaults to 127.0.0.1.
HOST=0.0.0.0
RENDER_TIMEOUT_SECONDS=20
MAX_SOURCE_BYTES=262144

# scripts/manage-daemon.sh
D2_STATE_DIR=~/.d2-renderer
LOG_LINES=50

# tests/test_server.py
TEST_TARGET_URL=http://127.0.0.1:8088
TEST_STANDIN_HOST=host.docker.internal
